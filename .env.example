# Enterprise Geospatial Intelligence Platform — Environment Configuration
# Copy to .env and adjust for your environment

# Application
APP_NAME=Enterprise Geospatial Intelligence Platform
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/v1
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+psycopg2://geospatial:geospatial@postgres:5432/geospatial_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# GeoServer (for WMS/WFS integration)
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver

# Ingestion
MAX_UPLOAD_SIZE_MB=500
DEFAULT_CRS=EPSG:4326
ALLOWED_CRS=EPSG:4326,EPSG:3857,EPSG:32618,EPSG:2278

# Pagination
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000
